#!/bin/sh
# Pre-push: format check + clippy (all targets), then the coverage gate.
#
# The coverage gate mirrors the CI `Coverage` job (.github/workflows/ci.yml):
# default features, genuine I/O excluded whole-file, >= 90% lines on the
# testable surface. It needs cargo-llvm-cov (`cargo install cargo-llvm-cov`);
# if it isn't installed the gate is skipped locally (CI still enforces it).
#
# Escape hatches:
#   SKIP_COVERAGE=1 git push   → run fmt+clippy but skip the (slow) coverage gate
#   git push --no-verify       → skip this hook entirely
#
# Note: cfg(target_os = "linux") code with C deps (alsa/opus/vorbis) is only
# fully verified in CI.
set -e

cargo fmt -- --check
cargo clippy --all-targets -- -D warnings

if [ "${SKIP_COVERAGE:-0}" = "1" ]; then
    echo "pre-push: SKIP_COVERAGE=1 -> skipping coverage gate."
    exit 0
fi
if ! command -v cargo-llvm-cov >/dev/null 2>&1; then
    echo "pre-push: cargo-llvm-cov not installed -> skipping coverage gate (CI enforces it)."
    echo "         install with: cargo install cargo-llvm-cov"
    exit 0
fi

cargo llvm-cov --workspace --summary-only \
    --ignore-filename-regex '(^|/)(main|logging)\.rs$|player/mod\.rs$|stream/(librespot|airplay|pipe|tcp|process|file|mod)\.rs$' \
    --fail-under-lines 90
